API_HOST=127.0.0.1
API_PORT=4310
WEB_PORT=4311
# Use this exact public dashboard origin when the Cloudflare Tunnel is enabled.
# VITE_ORIGIN=https://live.babiesbo.uk
# LIVE is the default. Set this only for local deterministic demos/tests.
# FIXTURE_MODE=1
FIXTURE_REPLAY_SPEED=1
# APSPORT includes every live football event plus prematch events starting in
# this many hours. Accepted range: 1..48.
APSPORT_PREMATCH_WINDOW_HOURS=24
# Set true only when you want the browser-focus buttons ("Mở ... tại sàn").
ENABLE_OPEN_PROVIDER_TICKET=false
# Legacy Playwright session renewal can open a visible Chrome window. The
# Chrome bridge is the primary data plane, so leave this off unless an operator
# explicitly starts a maintenance run.
SESSION_MAINTENANCE_ENABLED=0
# Fabet authentication always starts at https://fabet.com/. Provider tabs are
# reopened direct after login; the proxy/WARP path is used only by the temporary
# authentication browser. Keep credentials in the encrypted Sessions vault.
# FABET_AUTH_PROXY_URL=socks5://127.0.0.1:1080
# FABET_LOCAL_WARP_AUTH=1
# FABET_WARP_CLI_PATH=C:\Program Files\Cloudflare\Cloudflare WARP\warp-cli.exe
# FABET_WARP_PROXY_PORT=40000
# Data root. Windows: the current user's LOCALAPPDATA (required). macOS/Linux:
# defaults to ~/Library/Application Support or $XDG_DATA_HOME/~/.local/share;
# set LOCALAPPDATA only to override. The vault uses DPAPI on Windows and an
# AES-256-GCM file key (<data>/tool-chenh/.auth/local-vault.key, mode 0600)
# elsewhere.
